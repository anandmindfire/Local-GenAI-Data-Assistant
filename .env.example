# Application Configuration
APP_NAME=local-genai-assistant
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen3:1.7b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Qdrant Vector Store Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT=30
EMBEDDING_DIMENSION=768

# PostgreSQL Configuration (Read-Write Application Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=genai_db
POSTGRES_USER=genai_admin
POSTGRES_PASSWORD=genai_secret_password
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# PostgreSQL Read-Only Configuration (for SQL Agent)
POSTGRES_READONLY_USER=genai_readonly
POSTGRES_READONLY_PASSWORD=readonly_secret_password

# Document Ingestion Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_BATCH_SIZE=32
DOCUMENTS_DIRECTORY=data/documents
MAX_UPLOAD_SIZE_MB=25

# RAG & Retrieval Configuration
TOP_K=4
SIMILARITY_THRESHOLD=0.5
MAX_HISTORY_MESSAGES=10
